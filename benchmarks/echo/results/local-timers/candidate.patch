@@ -0,0 +1,404 @@
+// Released under the MIT License.
+// Copyright, 2026, by Samuel Williams.
+
+//! Experimental worker-owned timers. Only cross-thread updates use the owner's inbox.
+use crate::task_service::Shared;
+use core_scheduler_timers::local::{TimerKey, TimerQueue};
+use std::{
+    cell::RefCell,
+    future::Future,
+    io,
+    pin::Pin,
+    sync::{Arc, Weak},
+    task::{Context, Poll, Waker},
+    time::{Duration, Instant},
+};
+
+pub(crate) enum Command {
+    Update(TimerKey, Waker),
+    Release(TimerKey),
+}
+pub(crate) fn rejected(command: Command) {
+    // Closure may overtake an update after Sleep checked admission. Wake the replacement context too.
+    if let Command::Update(_, waker) = command {
+        crate::panic::contain(|| waker.wake());
+    }
+}
+struct LocalTimers {
+    scheduler: Weak<Shared>,
+    identifier: usize,
+    queue: TimerQueue<Waker>,
+}
+thread_local! {
+    static TIMERS: RefCell<Option<LocalTimers>> = const { RefCell::new(None) };
+}
+
+pub(crate) fn enter(shared: &Arc<Shared>, identifier: usize) {
+    TIMERS.with(|timers| {
+        timers.replace(Some(LocalTimers {
+            scheduler: Arc::downgrade(shared),
+            identifier,
+            queue: TimerQueue::with_capacity(shared.timer_capacity),
+        }))
+    });
+}
+pub(crate) fn exit() {
+    TIMERS.with(|timers| timers.take());
+}
+
+// The callback never polls application code or invokes a waker inside this RefCell borrow.
+fn local<T>(
+    shared: &Arc<Shared>,
+    owner: Option<usize>,
+    apply: impl FnOnce(&mut LocalTimers) -> T,
+) -> Option<T> {
+    TIMERS.with(|timers| {
+        let mut timers = timers.borrow_mut();
+        let local = timers.as_mut()?;
+        if !std::ptr::eq(local.scheduler.as_ptr(), Arc::as_ptr(shared))
+            || owner.is_some_and(|owner| owner != local.identifier)
+        {
+            return None;
+        }
+        Some(apply(local))
+    })
+}
+// Return a displaced waker to drop, or a replacement that must be woken because expiry won the race.
+fn apply(queue: &mut TimerQueue<Waker>, command: Command) -> (Option<Waker>, bool) {
+    match command {
+        Command::Release(key) => (queue.release(key), false),
+        Command::Update(key, waker) => match queue.update(key, waker) {
+            Ok(previous) => (Some(previous), false),
+            Err(replacement) => (Some(replacement), true),
+        },
+    }
+}
+fn deliver((waker, wake): (Option<Waker>, bool)) {
+    if wake {
+        crate::panic::contain(|| waker.unwrap().wake());
+    } else {
+        crate::panic::discard(waker);
+    }
+}
+fn dispatch(shared: &Arc<Shared>, owner: usize, command: Command) {
+    let mut command = Some(command);
+    if let Some(waker) = local(shared, Some(owner), |timers| {
+        apply(&mut timers.queue, command.take().unwrap())
+    }) {
+        deliver(waker);
+    } else {
+        shared.send_timer(owner, command.unwrap());
+    }
+}
+
+pub(crate) struct Sleep<'a> {
+    shared: &'a Arc<Shared>,
+    owner: usize,
+    key: TimerKey,
+    deadline: Instant,
+    waker: Waker,
+}
+impl Future for Sleep<'_> {
+    type Output = io::Result<()>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        if Instant::now() >= self.deadline {
+            return Poll::Ready(Ok(()));
+        }
+        if self.shared.is_closed() {
+            return Poll::Ready(Err(io::Error::new(
+                io::ErrorKind::BrokenPipe,
+                "clock is closed",
+            )));
+        }
+        if !self.waker.will_wake(cx.waker()) {
+            dispatch(
+                self.shared,
+                self.owner,
+                Command::Update(self.key, cx.waker().clone()),
+            );
+            self.waker.clone_from(cx.waker());
+        }
+        Poll::Pending
+    }
+}
+impl Drop for Sleep<'_> {
+    fn drop(&mut self) {
+        dispatch(self.shared, self.owner, Command::Release(self.key));
+    }
+}
+
+pub(crate) fn sleep<'a>(
+    shared: &'a Arc<Shared>,
+    deadline: Instant,
+    waker: &Waker,
+) -> Option<io::Result<Sleep<'a>>> {
+    let cached = waker.clone();
+    let mut wake = Some(waker.clone());
+    let registered = local(shared, None, |timers| {
+        if shared.is_closed() {
+            return Err(io::Error::new(io::ErrorKind::BrokenPipe, "clock is closed"));
+        }
+        Ok((
+            timers.identifier,
+            timers.queue.try_schedule(deadline, wake.take().unwrap()),
+        ))
+    })?;
+    Some(registered.and_then(|(owner, result)| {
+        result
+            .map(|key| Sleep {
+                shared,
+                owner,
+                key,
+                deadline,
+                waker: cached,
+            })
+            .map_err(|waker| {
+                drop(waker);
+                io::Error::new(io::ErrorKind::WouldBlock, "worker timer queue is full")
+            })
+    }))
+}
+
+pub(crate) fn turn(shared: &Arc<Shared>, identifier: usize) {
+    let incoming = &shared.workers[identifier].timers;
+    // Bound command processing to a snapshot so senders cannot extend this turn forever.
+    for _ in 0..incoming.len() {
+        let command = loop {
+            match incoming.steal() {
+                crossbeam_deque::Steal::Success(command) => break Some(command),
+                crossbeam_deque::Steal::Empty => break None,
+                crossbeam_deque::Steal::Retry => continue,
+            }
+        };
+        let Some(command) = command else { break };
+        let displaced = local(shared, Some(identifier), |timers| {
+            apply(&mut timers.queue, command)
+        })
+        .unwrap();
+        deliver(displaced);
+    }
+    // The common empty-queue path does not read the clock.
+    if local(shared, Some(identifier), |timers| {
+        timers.queue.next_deadline()
+    })
+    .unwrap()
+    .is_none()
+    {
+        return;
+    }
+    let now = Instant::now();
+    loop {
+        let wake = local(shared, Some(identifier), |timers| {
+            if shared.is_closed() {
+                timers.queue.pop()
+            } else {
+                timers.queue.pop_expired(now)
+            }
+        })
+        .unwrap();
+        let Some(wake) = wake else { break };
+        // Remove first, release the local borrow, then publish the runnable through its normal Waker.
+        crate::panic::contain(|| wake.wake());
+    }
+}
+
+pub(crate) fn timeout(shared: &Arc<Shared>, identifier: usize) -> Option<Duration> {
+    if !shared.workers[identifier].timers.is_empty() {
+        return Some(Duration::ZERO);
+    }
+    local(shared, Some(identifier), |timers| {
+        timers.queue.next_deadline()
+    })
+    .unwrap()
+    .map(|deadline| {
+        if shared.is_closed() {
+            Duration::ZERO
+        } else {
+            deadline.saturating_duration_since(Instant::now())
+        }
+    })
+}
