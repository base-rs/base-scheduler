+    #[test]
+    fn closure_wakes_local_timers_and_reports_capacity() {
+        let scheduler = scheduler(1);
+        let shared = Arc::clone(&scheduler);
+        let (registered, ready) = std::sync::mpsc::channel();
+        let task = scheduler
+            .spawn(async move {
+                let token = Cancellation::never();
+                let capacity =
+                    local(&shared.tasks.shared, None, |timers| timers.queue.capacity()).unwrap();
+                let mut sleeps = Vec::new();
+                for _ in 0..capacity {
+                    let mut sleep = Box::pin(shared.sleep(Duration::from_secs(3600), &token));
+                    assert!(poll_once(&mut sleep).await.is_none());
+                    sleeps.push(sleep);
+                }
+                assert_eq!(
+                    shared
+                        .sleep(Duration::from_secs(3600), &token)
+                        .await
+                        .unwrap_err()
+                        .kind(),
+                    io::ErrorKind::WouldBlock
+                );
+                registered.send(()).unwrap();
+                for sleep in sleeps {
+                    assert_eq!(sleep.await.unwrap_err().kind(), io::ErrorKind::BrokenPipe);
+                }
+            })
+            .unwrap();
+        ready.recv_timeout(Duration::from_secs(5)).unwrap();
+        scheduler.close();
+        block_on(task).unwrap();
+        block_on(scheduler.shutdown());
+    }
