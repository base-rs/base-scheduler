+    #[test]
+    fn expired_or_released_registration_wakes_a_late_replacement() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        struct Count(AtomicUsize);
+        impl std::task::Wake for Count {
+            fn wake(self: Arc<Self>) {
+                self.0.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+        let count = Arc::new(Count(AtomicUsize::new(0)));
+        let waker = Waker::from(Arc::clone(&count));
+        let mut queue = TimerQueue::with_capacity(4);
+        let now = Instant::now();
+        let key = queue.try_schedule(now, Waker::noop().clone()).unwrap();
+        queue.pop_expired(now).unwrap().wake();
+        // An update sent before expiry may be delivered after that expiry woke the old context.
+        deliver(apply(&mut queue, Command::Update(key, waker.clone())));
+        assert_eq!(count.0.load(Ordering::Relaxed), 1);
+        deliver(apply(&mut queue, Command::Release(key)));
+        queue.next_deadline();
+        let replacement = queue.try_schedule(now, Waker::noop().clone()).unwrap();
+        assert_ne!(key, replacement);
+        deliver(apply(&mut queue, Command::Update(key, waker)));
+        assert_eq!(count.0.load(Ordering::Relaxed), 2);
+        deliver(apply(&mut queue, Command::Release(replacement)));
+    }
+
+    #[test]
+    fn local_registration_repoll_and_drop_allocate_nothing() {
+        let scheduler = scheduler(64);
+        let shared = Arc::clone(&scheduler);
+        let task = scheduler
+            .spawn(async move {
+                let token = Cancellation::new();
+                let deadline = shared.now() + Duration::from_secs(3600);
+                let allocations = allocation_counter::measure(|| {
+                    for _ in 0..32 {
+                        let mut sleep = std::pin::pin!(shared.sleep_until(deadline, &token));
+                        let mut cx = Context::from_waker(Waker::noop());
+                        assert!(sleep.as_mut().poll(&mut cx).is_pending());
+                        assert!(sleep.as_mut().poll(&mut cx).is_pending());
+                    }
+                });
+                assert_eq!(allocations.count_total, 0, "{allocations:?}");
+                assert!(!shared.timers.has_started());
+            })
+            .unwrap();
+        block_on(task).unwrap();
+        block_on(scheduler.shutdown());
+    }
+
+    #[test]
+    fn local_timers_expire_and_do_not_start_the_fallback_thread() {
+        let scheduler = scheduler(64);
+        let shared = Arc::clone(&scheduler);
+        let task = scheduler
+            .spawn(async move {
+                for _ in 0..8 {
+                    let deadline = Instant::now() + Duration::from_millis(1);
+                    shared
+                        .sleep_until(deadline, &Cancellation::never())
+                        .await
+                        .unwrap();
+                    assert!(Instant::now() >= deadline);
+                }
+                assert!(!shared.timers.has_started());
+            })
