+    #[test]
+    #[allow(clippy::async_yields_async)] // Deliberately transfer a pending future to a different polling thread.
+    fn pending_sleep_can_move_to_another_thread_and_replace_its_waker() {
+        let scheduler = scheduler(64);
+        let shared = Arc::clone(&scheduler);
+        let task = scheduler
+            .spawn(async move {
+                let mut sleep = Box::pin(async move {
+                    shared
+                        .sleep(Duration::from_millis(30), &Cancellation::never())
+                        .await
+                });
+                assert!(poll_once(&mut sleep).await.is_none());
+                sleep
+            })
+            .unwrap();
+        let sleep = block_on(task).unwrap();
+        std::thread::spawn(move || block_on(sleep).unwrap())
+            .join()
+            .unwrap();
+        assert!(!scheduler.timers.has_started());
+        block_on(scheduler.shutdown());
+    }
