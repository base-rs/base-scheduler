+    #[test]
+    #[allow(clippy::async_yields_async)] // Deliberately drop a registered future outside its worker.
+    fn remote_drop_reclaims_capacity_and_cancellation_releases_local_waits() {
+        let scheduler = scheduler(1);
+        let shared = Arc::clone(&scheduler);
+        let task = scheduler
+            .spawn(async move {
+                let mut sleep = Box::pin(async move {
+                    shared
+                        .sleep(Duration::from_secs(3600), &Cancellation::never())
+                        .await
+                });
+                assert!(poll_once(&mut sleep).await.is_none());
+                sleep
+            })
+            .unwrap();
+        drop(block_on(task).unwrap());
+        let shared = Arc::clone(&scheduler);
+        let task = scheduler
+            .spawn(async move {
+                let token = Cancellation::new();
+                let mut sleep = std::pin::pin!(shared.sleep(Duration::from_secs(3600), &token));
+                assert!(poll_once(&mut sleep).await.is_none());
+                token.cancel();
+                assert!(matches!(
+                    sleep.await,
+                    Err(core_scheduler::OperationError::Cancelled(_))
+                ));
+            })
+            .unwrap();
+        block_on(task).unwrap();
+        block_on(scheduler.shutdown());
+    }
