@@ -5,6 +5,41 @@ use super::*;
 use std::sync::atomic::{AtomicUsize, Ordering as AtomicOrdering};
 use std::sync::{Barrier, Mutex};
 
+#[cfg(feature = "local")]
+#[test]
+fn local_capacity_pressure_reclaims_non_earliest_released_registrations() {
+    let now = Instant::now();
+    let mut timers = local::TimerQueue::with_capacity(4);
+    let capacity = timers.capacity();
+    let first = timers.try_schedule(now, 0).unwrap();
+    let keys: Vec<_> = (1..capacity)
+        .map(|value| {
+            timers
+                .try_schedule(now + Duration::from_secs(60), value)
+                .unwrap()
+        })
+        .collect();
+    assert_eq!(timers.next_deadline(), Some(now));
+    for (index, key) in keys.into_iter().enumerate() {
+        assert_eq!(timers.release(key), Some(index + 1));
+    }
+    let replacements: Vec<_> = (1..capacity)
+        .map(|value| {
+            timers
+                .try_schedule(now + Duration::from_secs(1), value + capacity)
+                .unwrap()
+        })
+        .collect();
+    assert_eq!(timers.capacity(), capacity);
+    assert_eq!(timers.try_schedule(now, 999), Err(999));
+    assert_eq!(timers.pop_expired(now), Some(0));
+    assert_eq!(timers.release(first), None);
+    for key in replacements {
+        assert!(timers.release(key).is_some());
+    }
+    assert_eq!(timers.next_deadline(), None);
+}
