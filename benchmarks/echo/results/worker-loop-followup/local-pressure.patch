 }
 
+#[cfg(feature = "local")]
+#[test]
+fn local_capacity_reclamation_and_expiry_allocate_nothing() {
+    use core_scheduler_timers::local::TimerQueue;
+    let now = Instant::now();
+    let mut timers = TimerQueue::with_capacity(64);
+    let capacity = timers.capacity();
+    let mut keys = Vec::with_capacity(capacity);
+    let calls = allocations(|| {
+        for _ in 0..3 {
+            for index in 0..capacity {
+                keys.push(
+                    timers
+                        .try_schedule(now + Duration::from_nanos(index as u64), index)
+                        .unwrap(),
+                );
+            }
+            timers.next_deadline();
+            // Keep the root alive while all later registrations are released.
+            for key in keys.drain(1..) {
+                assert!(timers.release(key).is_some());
+            }
+            for index in 1..capacity {
+                keys.push(timers.try_schedule(now, index).unwrap());
+            }
+            assert_eq!(timers.try_schedule(now, 999), Err(999));
+            while timers.pop_expired(now + Duration::from_secs(1)).is_some() {}
+            for key in keys.drain(..) {
+                assert_eq!(timers.release(key), None);
+            }
+        }
+    });
+    assert_eq!(calls, 0);
+    assert_eq!(timers.capacity(), capacity);
+}
