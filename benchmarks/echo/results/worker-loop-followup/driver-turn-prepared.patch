+#[test]
+fn message_vector_callbacks_run_before_enqueue_with_stable_inline_vectors() {
+    use core_scheduler_selector::{SelectorDriver, SelectorWorker};
+    use std::time::{Duration, Instant};
+    for send in [false, true] {
+        let (selector, driver) = pair(2);
+        let socket = block_on(socket(&selector));
+        if !send {
+            std::net::UdpSocket::bind("127.0.0.1:0")
+                .unwrap()
+                .send_to(b"vector", socket.local_addr().unwrap())
+                .unwrap();
+        }
+        let mut worker = driver.enter();
+        let accesses = Arc::new(AtomicUsize::new(0));
+        let buffers = WakeOnVectors {
+            buffers: InlineBuffers::new(b"vector".to_vec()),
+            accesses: Arc::clone(&accesses),
+            wake: worker.waker(),
+        };
+        let never = Cancellation::never();
+        let mut future = Box::pin(operation(&selector, &socket, buffers, send, &never));
+        assert!(block_on(poll_once(&mut future)).is_none());
+        assert_eq!(accesses.load(Ordering::SeqCst), 1);
+        let Command::Submit(request) =
+            crate::io_uring_worker::pop(&selector.controllers[0]).unwrap()
+        else {
+            panic!("expected local submission")
+        };
+        assert_eq!(
+            request.entry().get_opcode() as u8,
+            if send {
+                opcode::SendMsg::CODE
+            } else {
+                opcode::RecvMsg::CODE
+            }
+        );
+        assert_eq!(accesses.load(Ordering::SeqCst), 1);
+        assert!(
+            selector.controllers[0]
+                .send(Command::Submit(request))
+                .is_ok()
+        );
+        {
+            let _failure = Failures::new([("wait", io::ErrorKind::PermissionDenied.into())]);
+            assert!(!worker.turn(None).unwrap());
+            // The vector callback's explicit local wake prevents an idle wait.
+            // A fatal injected wait error would have made turn() fail above.
+        }
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let (result, buffers) = loop {
+            if let Some(result) = block_on(poll_once(&mut future)) {
+                break result;
+            }
+            assert!(!worker.turn(Some(Duration::ZERO)).unwrap());
+            assert!(Instant::now() < deadline);
+        };
+        assert_eq!(result.unwrap(), 6);
+        assert_eq!(buffers.buffers.bytes.len(), 6);
+        assert_eq!(accesses.load(Ordering::SeqCst), 1);
+        selector.close();
+        while !worker.turn(Some(Duration::from_millis(10))).unwrap() {}
+        block_on(selector.shutdown());
+    }
+}
