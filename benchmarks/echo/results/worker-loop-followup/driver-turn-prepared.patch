+struct WakeOnVectors {
+    buffers: InlineBuffers,
+    accesses: Arc<AtomicUsize>,
+    wake: std::task::Waker,
+}
+// SAFETY: The wrapper retains InlineBuffers' unchanged byte range and prepared
+// vectors. Notifying a waker neither changes nor shares their storage.
+unsafe impl IoBufSequence for WakeOnVectors {
+    fn buffer_count(&self) -> usize {
+        self.buffers.buffer_count()
+    }
+    fn buffer(&self, index: usize) -> &[u8] {
+        self.buffers.buffer(index)
+    }
+    fn io_slices(&self) -> Option<&[std::io::IoSlice<'_>]> {
+        self.accesses.fetch_add(1, Ordering::SeqCst);
+        self.wake.wake_by_ref();
+        self.buffers.io_slices()
+    }
+}
+// SAFETY: Writable storage is exclusively retained by InlineBuffers.
+unsafe impl IoBufSequenceMut for WakeOnVectors {
+    fn buffer_mut(&mut self, index: usize) -> &mut [u8] {
+        self.buffers.buffer_mut(index)
+    }
+    fn io_slices_mut(&mut self) -> Option<&[std::io::IoSliceMut<'_>]> {
+        self.accesses.fetch_add(1, Ordering::SeqCst);
+        self.wake.wake_by_ref();
+        self.buffers.io_slices_mut()
+    }
+}
