+        self.accesses.fetch_add(1, Ordering::SeqCst);
+        self.wake.wake_by_ref();
+        &self.bytes
+    }
+}
+impl AsMut<[u8]> for WakeOnBufferAccess {
+    fn as_mut(&mut self) -> &mut [u8] {
+        self.accesses.fetch_add(1, Ordering::SeqCst);
+        self.wake.wake_by_ref();
+        &mut self.bytes
+    }
+}
