+#[test]
+fn quiescence_before_listening_and_concurrent_abandoned_waiters_preserve_progress() {
+    for run_first in [false, true] {
+        let (service, _queues) = queued_service(1);
+        let task = service.spawn(std::future::pending::<()>()).unwrap();
+        let run_one = || {
