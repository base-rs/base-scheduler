+async fn scheduler_server_raw<S>(
+    scheduler: Arc<S>,
+    listener: TcpListener,
+    connections: usize,
+    poll: bool,
+) where
+    S: SocketRegistration
+        + SocketAccept
+        + SocketRead
+        + SocketWrite
+        + SocketRecvPoll
+        + SocketSendPoll
+        + SocketSetOption<TcpNoDelay>
+        + Spawn
+        + Send
+        + Sync
+        + 'static,
+{
+    let listener = scheduler
+        .register_listener(listener)
+        .expect("scheduler listener registration");
+    let mut tasks = Vec::with_capacity(connections);
+    let never = Cancellation::never();
+    for _ in 0..connections {
+        let (socket, _) = scheduler
+            .socket_accept(&listener, &never)
+            .await
+            .expect("accept connection");
+        scheduler
+            .socket_set_option(&socket, TcpNoDelay, true, &never)
+            .await
+            .expect("TCP_NODELAY");
+        let shared = Arc::clone(&scheduler);
+        let task = if poll {
+            tokio::spawn(async move { echo_poll(shared.as_ref(), socket).await })
+        } else {
+            tokio::spawn(async move { echo(shared.as_ref(), socket).await })
+        };
+        tasks.push(task);
+    }
+    for task in tasks {
+        task.await.expect("echo task failed");
+    }
+}
