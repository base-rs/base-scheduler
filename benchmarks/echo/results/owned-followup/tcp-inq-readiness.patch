+// Diagnostic prototype: consumes the kernel's queue-length hint instead of inferring drainage from a short read.
+pub(crate) fn recv_inq(
+    socket: &Socket,
+    bytes: &mut [u8],
+    flags: SocketRecvFlags,
+) -> io::Result<(usize, bool)> {
+    #[cfg(target_os = "linux")]
+    unsafe {
+        let mut vector = libc::iovec {
+            iov_base: bytes.as_mut_ptr().cast(),
+            iov_len: bytes.len(),
+        };
+        let mut control = [0usize; 8];
+        let mut message: libc::msghdr = std::mem::zeroed();
+        message.msg_iov = &mut vector;
+        message.msg_iovlen = 1;
+        message.msg_control = control.as_mut_ptr().cast();
+        message.msg_controllen = std::mem::size_of_val(&control);
+        let count = libc::recvmsg(
+            socket.as_raw_fd(),
+            &mut message,
+            POLL_FLAGS | recv_flags(flags),
+        );
+        if count < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let mut drained = false;
+        if count > 0 && !flags.peek && message.msg_flags & libc::MSG_CTRUNC == 0 {
+            let mut header = libc::CMSG_FIRSTHDR(&message);
+            while !header.is_null() {
+                if (*header).cmsg_level == libc::IPPROTO_TCP
+                    && (*header).cmsg_type == libc::TCP_CM_INQ
+                    && (*header).cmsg_len >= libc::CMSG_LEN(4) as usize
+                {
+                    drained = std::ptr::read_unaligned(libc::CMSG_DATA(header).cast::<i32>()) == 0;
+                }
+                header = libc::CMSG_NXTHDR(&message, header);
+            }
+        }
+        Ok((count as usize, drained))
+    }
+    #[cfg(not(target_os = "linux"))]
+    recv_poll(socket, bytes, flags).map(|count| (count, false))
+}
