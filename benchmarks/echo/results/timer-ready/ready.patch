+#[cfg(feature = "ready-timers")]
+#[test]
+fn idle_worker_can_steal_timer_delivery_from_both_ready_generations() {
+    use super::{LocalWorker, search};
+    use crate::task_service::Shared;
+    use std::{sync::Arc, task::Waker};
+    let mut queues: Vec<[Worker<Ready>; 2]> = (0..2)
+        .map(|_| std::array::from_fn(|_| Worker::new_fifo()))
+        .collect();
+    let shared = Arc::new(Shared::new(&queues));
+    let [ready, current] = queues.remove(0);
+    let local = LocalWorker {
+        identifier: 0,
+        scheduler: Arc::downgrade(&shared),
+        ready,
+        current,
+    };
+    let count = Arc::new(Interrupts::default());
+    for queue in &queues[0] {
+        shared.admit_ready_timer();
+        queue.push(Ready::Timer(Waker::from(Arc::clone(&count))));
+        let timer = search(&shared, &local, 1).success().unwrap();
+        assert!(matches!(timer, Ready::Timer(_)));
+        super::run_ready(&shared, 0, timer);
+    }
+    assert_eq!(count.0.load(Ordering::SeqCst), 2);
+    assert!(matches!(search(&shared, &local, 1), Steal::Empty));
+}
+
+#[cfg(feature = "ready-timers")]
+#[test]
+fn timer_delivery_remains_outstanding_until_the_waker_returns() {
+    use crate::task_service::{Shared, TaskService};
+    use std::{
+        sync::Arc,
+        task::{Wake, Waker},
+    };
+    struct CheckDelivery(Arc<Shared>);
+    impl Wake for CheckDelivery {
+        fn wake(self: Arc<Self>) {
+            assert!(
+                !self.0.finished(),
+                "shutdown completed during timer delivery"
+            );
+            // Waker invocation must not hold the executor's TLS RefCell borrow.
+            assert!(!super::is_worker());
+        }
+    }
+    let queues = std::array::from_fn::<_, 2, _>(|_| Worker::new_fifo());
+    let shared = Arc::new(Shared::new(std::slice::from_ref(&queues)));
+    let service = TaskService {
+        shared: Arc::clone(&shared),
+    };
+    service.close();
+    assert!(shared.finished());
+    shared.admit_ready_timer();
+    assert!(!shared.finished());
+    let ready = Ready::Timer(Waker::from(Arc::new(CheckDelivery(Arc::clone(&shared)))));
+    super::run_ready(&shared, 0, ready);
+    assert!(shared.finished());
+}
