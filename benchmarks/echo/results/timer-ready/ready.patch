+    #[cfg(feature = "ready-timers")]
+    #[test]
+    fn dropping_an_expired_sleep_before_queued_delivery_is_safe() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        struct Count(AtomicUsize);
+        impl std::task::Wake for Count {
+            fn wake(self: Arc<Self>) {
+                self.0.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        let scheduler = scheduler(64);
+        let shared = Arc::clone(&scheduler);
+        let count = Arc::new(Count(AtomicUsize::new(0)));
+        let delivered = Arc::clone(&count);
+        let task = scheduler
+            .spawn(async move {
+                let deadline = Instant::now() + Duration::from_millis(1);
+                let waker = Waker::from(Arc::clone(&delivered));
+                let sleep = sleep(&shared.tasks.shared, deadline, &waker)
+                    .unwrap()
+                    .unwrap();
+                // Hold this worker in its current task until expiry. The timer action
+                // is then explicitly collected, but cannot run until this task yields.
+                std::thread::sleep(Duration::from_millis(2));
+                turn(&shared.tasks.shared, sleep.owner);
+                assert_eq!(delivered.0.load(Ordering::SeqCst), 0);
+                drop(sleep);
+                assert_eq!(delivered.0.load(Ordering::SeqCst), 0);
+            })
+            .unwrap();
+        block_on(task).unwrap();
+        block_on(scheduler.shutdown());
+        assert_eq!(count.0.load(Ordering::SeqCst), 1);
+    }
