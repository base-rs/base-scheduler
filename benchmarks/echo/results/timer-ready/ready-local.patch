+#[cfg(feature = "ready-timer-local")]
+#[test]
+fn stolen_timer_delivery_routes_its_task_to_the_delivering_worker() {
+    use super::{CURRENT_WORKER, LocalWorker};
+    use crate::task_service::Shared;
+    use std::{
+        sync::Arc,
+        task::{Wake, Waker},
+    };
+    struct ScheduleTask(Arc<Shared>);
+    impl Wake for ScheduleTask {
+        fn wake(self: Arc<Self>) {
+            let Ready::Task(task) = runnable() else {
+                unreachable!()
+            };
+            task.metadata().worker.store(0, Ordering::Relaxed);
+            self.0.admit_ready_timers(1);
+            super::schedule(&self.0, task);
+        }
+    }
+    let mut queues: Vec<[Worker<Ready>; 2]> = (0..2)
+        .map(|_| std::array::from_fn(|_| Worker::new_fifo()))
+        .collect();
+    let shared = Arc::new(Shared::new(&queues));
+    let [ready, current] = queues.remove(1);
+    CURRENT_WORKER.with(|context| {
+        context.replace(Some(LocalWorker {
+            identifier: 1,
+            scheduler: Arc::downgrade(&shared),
+            delivering_timer: false,
+            ready,
+            current,
+        }))
+    });
+    let waker = Waker::from(Arc::new(ScheduleTask(Arc::clone(&shared))));
+    shared.admit_ready_timers(1);
+    queues[0][0].push(Ready::Timer(waker.clone()));
+    let timer = super::find_work(&shared, 1).success().unwrap();
+    assert!(matches!(timer, Ready::Timer(_)));
+    super::run_ready(&shared, 1, timer);
+    assert!(shared.workers[0].incoming.is_empty());
+    let local = CURRENT_WORKER.with(|context| {
+        let context = context.borrow();
+        let local = context.as_ref().unwrap();
+        assert!(!local.delivering_timer);
+        local.ready.pop().unwrap()
+    });
+    assert!(matches!(local, Ready::Task(_)));
+    drop(local);
+    shared.retire_runnable();
+
+    // The scoped override must not change normal preferred-worker scheduling.
+    waker.wake();
+    let normal = shared.workers[0].incoming.steal().success().unwrap();
+    assert!(matches!(normal, Ready::Task(_)));
+    drop(normal);
+    shared.retire_runnable();
+    CURRENT_WORKER.with(|context| context.take());
+}
