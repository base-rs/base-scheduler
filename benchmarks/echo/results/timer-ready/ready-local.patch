+#[cfg(feature = "ready-timers")]
+#[test]
+fn timer_delivery_remains_outstanding_until_the_waker_returns() {
+    use crate::task_service::{Shared, TaskService};
+    use std::{
+        sync::Arc,
+        task::{Wake, Waker},
+    };
+    struct CheckDelivery(Arc<Shared>);
+    impl Wake for CheckDelivery {
+        fn wake(self: Arc<Self>) {
+            assert!(
+                !self.0.finished(),
+                "shutdown completed during timer delivery"
+            );
+            // Waker invocation must not hold the executor's TLS RefCell borrow.
+            assert!(!super::is_worker());
+        }
+    }
+    let queues = std::array::from_fn::<_, 2, _>(|_| Worker::new_fifo());
+    let shared = Arc::new(Shared::new(std::slice::from_ref(&queues)));
+    let service = TaskService {
+        shared: Arc::clone(&shared),
+    };
+    service.close();
+    assert!(shared.finished());
+    shared.admit_ready_timers(1);
+    assert!(!shared.finished());
+    let ready = Ready::Timer(Waker::from(Arc::new(CheckDelivery(Arc::clone(&shared)))));
+    super::run_ready(&shared, 0, ready);
+    assert!(shared.finished());
+}
