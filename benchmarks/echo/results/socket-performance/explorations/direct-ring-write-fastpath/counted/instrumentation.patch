+// Experimental notification counts; excluded from shipping code and timing binaries.
+use std::cell::Cell;
+thread_local! { static COUNTERS: Counters = const { Counters { values: [const { Cell::new(0) }; 7] } }; }
+struct Counters { values: [Cell<u64>; 7] }
+pub(crate) const OWNER_WRITE_ATTEMPT: usize = 0;
+pub(crate) const REMOTE_WRITE_ATTEMPT: usize = 1;
+pub(crate) const OWNER_WRITE_SUCCESS: usize = 2;
+pub(crate) const REMOTE_WRITE_SUCCESS: usize = 3;
+pub(crate) const OWNER_WAKE_AVOIDED: usize = 4;
+pub(crate) const PAYLOAD_CQE: usize = 5;
+pub(crate) const NOTIFICATION_CQE: usize = 6;
+pub(crate) fn increment(index: usize) { COUNTERS.with(|c| c.values[index].set(c.values[index].get()+1)); }
+pub(crate) fn write(owner: bool, success: bool) {
+    increment(if owner { OWNER_WRITE_ATTEMPT } else { REMOTE_WRITE_ATTEMPT });
+    if success { increment(if owner { OWNER_WRITE_SUCCESS } else { REMOTE_WRITE_SUCCESS }); }
+}
+impl Drop for Counters {
+    fn drop(&mut self) {
+        use std::fmt::Write;
+        if self.values.iter().all(|x| x.get()==0) { return; }
+        let mut s=String::from("{");
+        write!(&mut s, "\"owner_write_attempt\":{}", self.values[0].get()).unwrap();
+        write!(&mut s, ",\"remote_write_attempt\":{}", self.values[1].get()).unwrap();
+        write!(&mut s, ",\"owner_write_success\":{}", self.values[2].get()).unwrap();
+        write!(&mut s, ",\"remote_write_success\":{}", self.values[3].get()).unwrap();
+        write!(&mut s, ",\"owner_wake_avoided\":{}", self.values[4].get()).unwrap();
+        write!(&mut s, ",\"payload_cqe\":{}", self.values[5].get()).unwrap();
+        write!(&mut s, ",\"notification_cqe\":{}", self.values[6].get()).unwrap();
+        s.push('}');
+        eprintln!("NOTIFICATION_COUNTERS {}", s);
+    }
+}
