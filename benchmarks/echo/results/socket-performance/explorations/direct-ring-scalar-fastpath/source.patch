+pub(crate) fn take_notification(controller: &Controller) -> bool {
+    ROUTES.with(|routes| {
+        routes
+            .borrow()
+            .iter()
+            .rev()
+            .find(|route| std::ptr::eq(Arc::as_ptr(&route.controller), controller))
+            .is_some_and(|route| route.notified.replace(false))
+    })
