+pub(crate) fn notify(controller: &Controller) -> bool {
+    ROUTES.with(|routes| {
+        let routes = routes.borrow();
+        if let Some(route) = routes
+            .iter()
+            .rev()
+            .find(|route| std::ptr::eq(Arc::as_ptr(&route.controller), controller))
+        {
+            route.notified.set(true);
+            true
+        } else {
+            false
+        }
+    })
