+// PollAdd retains only a descriptor and identifier, so readiness records can move
+// between queues. Owned operations keep stable boxed storage for kernel pointers.
+pub(crate) enum QueuedRequest {
+    Owned(Box<dyn PendingRequest>),
+    Readiness(readiness::ReadinessRequest),
+}
+
+impl QueuedRequest {
+    fn identifier(&self) -> u64 {
+        match self {
+            Self::Owned(request) => request.identifier(),
+            Self::Readiness(request) => request.identifier(),
+        }
+    }
+
+    fn entry(&mut self) -> squeue::Entry {
+        match self {
+            Self::Owned(request) => request.entry(),
+            Self::Readiness(request) => request.entry(),
+        }
+    }
+
+    fn finish(self, result: io::Result<usize>) {
+        match self {
+            Self::Owned(request) => request.finish(result),
+            Self::Readiness(request) => request.finish(result),
+        }
+    }
+
+    fn cancelling(&self) -> bool {
+        match self {
+            Self::Owned(request) => request.cancelling(),
+            Self::Readiness(request) => request.cancelling(),
+        }
+    }
+
+    fn set_cancelling(&self) {
+        match self {
+            Self::Owned(request) => request.set_cancelling(),
+            Self::Readiness(request) => request.set_cancelling(),
+        }
+    }
+
+    fn take_reply(&self) -> Option<Box<dyn Send>> {
+        match self {
+            Self::Owned(request) => request.take_reply(),
+            Self::Readiness(request) => request.take_reply(),
+        }
+    }
+}
