+// Keys are internal, never-reused u64 request IDs. An odd multiplier preserves distinct integer hashes and spreads sequential IDs over the table index and its upper-bit fingerprints without keyed string hashing.
+#[derive(Default)]
+struct IdentifierHasher(u64);
+
+impl Hasher for IdentifierHasher {
+    fn finish(&self) -> u64 {
+        self.0
+    }
+
+    fn write(&mut self, _: &[u8]) {
+        unreachable!("request identifiers hash with write_u64")
+    }
+
+    fn write_u64(&mut self, identifier: u64) {
+        self.0 = identifier.wrapping_mul(0x9e37_79b9_7f4a_7c15);
+    }
+}
