  "patch": "diff --git a/crates/iouring/src/io_uring_selector/monitor.rs b/crates/iouring/src/io_uring_selector/monitor.rs\nindex 5ae89db..f3eceb9 100644\n--- a/crates/iouring/src/io_uring_selector/monitor.rs\n+++ b/crates/iouring/src/io_uring_selector/monitor.rs\n@@ -56,18 +56,14 @@ impl IoUringMonitorRegistration {\n         ));\n     }\n \n-    // `try_update` is not available on the supported Rust 1.85 toolchain.\n-    #[allow(deprecated)]\n     fn notify(&self) {\n         let waker = {\n             let mut status = self.status.lock().unwrap();\n             // The low bit caches readiness; the remaining bits distinguish notifications racing a syscall. Like readiness ticks in other reactors, this counter wraps.\n-            discard(\n-                self.readiness\n-                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {\n-                        Some(value.wrapping_add(2) | READY)\n-                    }),\n-            );\n+            // Notifications are serialized by `status`. A concurrent clear can only remove READY from the previous generation; this notification always publishes a new one.\n+            let readiness = self.readiness.load(Ordering::Relaxed);\n+            self.readiness\n+                .store(readiness.wrapping_add(2) | READY, Ordering::Release);\n             status.waker.take()\n         };\n         wake(waker);\n@@ -107,6 +103,7 @@ impl MonitorState for IoUringMonitorRegistration {\n \n struct Wait<'a> {\n     storage: &'a State,\n+    registered: bool,\n }\n impl<'a> Wait<'a> {\n     fn claim(storage: &'a State) -> io::Result<Self> {\n@@ -121,20 +118,25 @@ impl<'a> Wait<'a> {\n                 \"socket monitor already has a waiter\",\n             ));\n         }\n-        Ok(Self { storage })\n+        Ok(Self {\n+            storage,\n+            registered: false,\n+        })\n     }\n }\n impl Drop for Wait<'_> {\n     fn drop(&mut self) {\n-        let previous = self\n-            .storage\n-            .registration()\n-            .status\n-            .lock()\n-            .unwrap()\n-            .waker\n-            .take();\n-        discard(previous);\n+        if self.registered {\n+            let previous = self\n+                .storage\n+                .registration()\n+                .status\n+                .lock()\n+                .unwrap()\n+                .waker\n+                .take();\n+            discard(previous);\n+        }\n         self.storage\n             .registration()\n             .claimed\n@@ -166,7 +168,7 @@ impl IoUringSelector {\n         let registration = state.registration();\n         cancellation.check()?;\n         self.check_monitor(state)?;\n-        let _wait = Wait::claim(state)?;\n+        let mut wait = Wait::claim(state)?;\n         // Choose a route once for this wait. A suspended future can move without moving its active registration. The next wait may retire and rebind it after a worker change.\n         let controller = self.route();\n         let mut cancelled = pin!(cancellation.cancelled());\n@@ -178,6 +180,7 @@ impl IoUringSelector {\n             let replacement = context.waker().clone();\n             let (previous, submission, retirement) = {\n                 let mut status = registration.status.lock().unwrap();\n+                wait.registered = status.waker.is_some();\n                 if !status.retiring {\n                     if let Some(error) = status.error.take() {\n                         return Poll::Ready(Err(error.into()));\n@@ -215,6 +218,7 @@ impl IoUringSelector {\n                         generation,\n                     ));\n                 }\n+                wait.registered = true;\n                 (status.waker.replace(replacement), submission, retirement)\n             };\n             discard(previous);\n@@ -242,15 +246,17 @@ impl IoUringSelector {\n                 \"socket monitor belongs to another selector\",\n             ));\n         }\n-        let _wait = Wait::claim(state)?;\n+        let mut wait = Wait::claim(state)?;\n         registration.retire(true);\n         poll_fn(|context| {\n             let replacement = context.waker().clone();\n             let previous = {\n                 let mut status = registration.status.lock().unwrap();\n+                wait.registered = status.waker.is_some();\n                 if !status.pending {\n                     return Poll::Ready(Ok(()));\n                 }\n+                wait.registered = true;\n                 status.waker.replace(replacement)\n             };\n             discard(previous);",
