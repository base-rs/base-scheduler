  "patch": "diff --git a/crates/iouring/src/io_uring_selector/monitor.rs b/crates/iouring/src/io_uring_selector/monitor.rs\nindex 5ae89db..59e8593 100644\n--- a/crates/iouring/src/io_uring_selector/monitor.rs\n+++ b/crates/iouring/src/io_uring_selector/monitor.rs\n@@ -56,18 +56,14 @@ impl IoUringMonitorRegistration {\n         ));\n     }\n \n-    // `try_update` is not available on the supported Rust 1.85 toolchain.\n-    #[allow(deprecated)]\n     fn notify(&self) {\n         let waker = {\n             let mut status = self.status.lock().unwrap();\n             // The low bit caches readiness; the remaining bits distinguish notifications racing a syscall. Like readiness ticks in other reactors, this counter wraps.\n-            discard(\n-                self.readiness\n-                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {\n-                        Some(value.wrapping_add(2) | READY)\n-                    }),\n-            );\n+            // Notifications are serialized by `status`. A concurrent clear can only remove READY from the previous generation; this notification always publishes a new one.\n+            let readiness = self.readiness.load(Ordering::Relaxed);\n+            self.readiness\n+                .store(readiness.wrapping_add(2) | READY, Ordering::Release);\n             status.waker.take()\n         };\n         wake(waker);",
