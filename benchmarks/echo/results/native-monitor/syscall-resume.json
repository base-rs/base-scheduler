  "patch": "diff --git a/crates/iouring/src/io_uring_selector/monitor.rs b/crates/iouring/src/io_uring_selector/monitor.rs\nindex 5ae89db..3f42915 100644\n--- a/crates/iouring/src/io_uring_selector/monitor.rs\n+++ b/crates/iouring/src/io_uring_selector/monitor.rs\n@@ -276,7 +276,30 @@ impl IoUringSelector {\n             match operation(state.socket()) {\n                 Err(error) if error.kind() == io::ErrorKind::WouldBlock => {\n                     registration.clear_readiness(readiness);\n-                    self.monitor_wait(monitor, cancellation).await?\n+                    let mut wait = pin!(self.monitor_wait(monitor, cancellation));\n+                    let mut first = true;\n+                    let result = poll_fn(|context| {\n+                        if !first {\n+                            cancellation.check()?;\n+                            self.check_monitor(state)?;\n+                            let readiness = registration.readiness.load(Ordering::Acquire);\n+                            match operation(state.socket()) {\n+                                Err(error) if error.kind() == io::ErrorKind::WouldBlock => {\n+                                    registration.clear_readiness(readiness);\n+                                }\n+                                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}\n+                                result => return Poll::Ready(result.map(Some).map_err(Into::into)),\n+                            }\n+                        }\n+                        first = false;\n+                        wait.as_mut()\n+                            .poll(context)\n+                            .map(|result| result.map(|()| None))\n+                    })\n+                    .await?;\n+                    if let Some(result) = result {\n+                        return Ok(result);\n+                    }\n                 }\n                 Err(error) if error.kind() == io::ErrorKind::Interrupted => {\n                     cancellation.check()?;",
