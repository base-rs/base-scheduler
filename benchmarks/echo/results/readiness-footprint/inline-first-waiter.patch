@@ -18,7 +18,33 @@ struct Entry {
 struct State {
     // Highest issued ID, never reused even when a slot is recycled.
     last_id: usize,
-    entries: Vec<Option<Entry>>,
+    // A direction usually has one waiter. Keep it inline, beside the lock.
+    first: Option<Entry>,
+    rest: Vec<Option<Entry>>,
+}
+impl State {
+    fn slot(&mut self, index: usize) -> &mut Option<Entry> {
+        match index {
+            0 => &mut self.first,
+            index => &mut self.rest[index - 1],
+        }
+    }
+    fn insert(&mut self, entry: Entry) -> usize {
+        if self.first.is_none() {
+            self.first = Some(entry);
+            return 0;
+        }
+        match self.rest.iter().position(Option::is_none) {
+            Some(index) => {
+                self.rest[index] = Some(entry);
+                index + 1
+            }
+            None => {
+                self.rest.push(Some(entry));
+                self.rest.len()
+            }
+        }
+    }
 }
 
