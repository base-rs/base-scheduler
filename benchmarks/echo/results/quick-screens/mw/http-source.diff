+//! Multi-worker HTTP modes: N application workers and one spawned task per accepted connection.
+//!
+//! The single-worker modes poll every connection in one `FuturesUnordered` supervisor, which cannot use a second worker. Here each connection is its own task, so a work-stealing executor can spread connections across workers. Responses, handlers, `TCP_NODELAY` and the admission bound are the same as in the single-worker modes.
+//!
+//! Both accept loops run in the runtime's `block_on` root on the main thread, which is the standard `#[tokio::main]` Hyper server shape. The main thread inherits the server's CPU affinity. With persistent wrk connections, accepting happens only at the start of a sample.
+
+use super::{Hello, MAX_CONNECTIONS, Result, connection_finished, ready};
+use base_scheduler::{
+    Cancellation, SocketAccept, SocketClose, SocketRegistration, SocketSetOption,
+    SocketStreamReading, SocketStreamWriting, Spawn, TcpNoDelay,
+};
+use futures_util::{
+    future::{Either, select},
+    stream::{FuturesUnordered, StreamExt},
+};
+use http_body_util::Full;
+use hyper::{body::Bytes, server::conn::http1, service::service_fn};
+use hyper_util::rt::TokioIo;
+use std::{convert::Infallible, net::TcpListener, pin::pin, sync::Arc};
+
+type Joined = std::result::Result<std::result::Result<u64, base_http_server::Error>, base_scheduler::TaskError>;
+
+fn task_finished(result: Joined) {
+    match result {
+        Ok(result) => connection_finished(result),
+        Err(error) => connection_finished(Err::<(), _>(error)),
+    }
+}
+
+/// Accept on the calling task and spawn `base_http_server::serve_connection` for each connection. `serve` itself polls connections in one supervisor future and spawns nothing, so it cannot use more than one worker.
+pub async fn base_server<S>(scheduler: Arc<S>) -> Result<()>
+where
+    S: SocketRegistration
+        + SocketAccept
+        + SocketSetOption<TcpNoDelay>
+        + SocketStreamReading
+        + SocketStreamWriting
+        + SocketClose
+        + Spawn
+        + Send
+        + Sync
+        + 'static,
+    S::Socket: 'static,
+{
+    let listener = TcpListener::bind("127.0.0.1:0")?;
+    ready(&listener)?;
+    let listener = scheduler.register_listener(listener)?;
+    let cancellation = Cancellation::never();
+    let options = Arc::new(base_http1::Options::default());
+    // Base dropping a task handle requests cancellation, so the acceptor retains every handle. A handle only wakes this task when its connection ends.
+    let mut connections = FuturesUnordered::new();
+    loop {
+        if connections.len() == MAX_CONNECTIONS {
+            task_finished(connections.next().await.unwrap());
+            continue;
+        }
+        let accepted = {
+            let mut accept = pin!(scheduler.socket_accept(&listener, &cancellation));
+            loop {
+                let completed = pin!(async {
+                    if connections.is_empty() {
+                        std::future::pending().await
+                    } else {
+                        connections.next().await.unwrap()
+                    }
+                });
+                match select(accept.as_mut(), completed).await {
+                    Either::Left((accepted, _)) => break accepted,
+                    Either::Right((completed, _)) => task_finished(completed),
+                }
+            }
+        };
+        let (socket, _) = accepted?;
+        scheduler
+            .socket_set_option(&socket, TcpNoDelay, true, &cancellation)
+            .await?;
+        let shared = scheduler.clone();
+        let options = options.clone();
+        connections.push(scheduler.spawn(async move {
+            base_http_server::serve_connection(
+                shared.as_ref(),
+                socket,
+                &Hello,
+                &options,
+                &Cancellation::never(),
+            )
+            .await
+        })?);
+    }
+}
+
+/// The standard Hyper server: accept in the root and `tokio::spawn` each connection, dropping its join handle.
+pub async fn hyper_server() -> Result<()> {
+    let listener = TcpListener::bind("127.0.0.1:0")?;
+    ready(&listener)?;
+    listener.set_nonblocking(true)?;
+    let listener = tokio::net::TcpListener::from_std(listener)?;
+    let mut builder = http1::Builder::new();
+    // Base currently emits no automatic Date field. Match the response work.
+    builder.auto_date_header(false);
+    loop {
+        let (socket, _) = listener.accept().await?;
+        socket.set_nodelay(true)?;
+        let connection = builder.serve_connection(
+            TokioIo::new(socket),
+            service_fn(|_: hyper::Request<hyper::body::Incoming>| async {
+                let mut response = hyper::Response::new(Full::new(Bytes::from_static(super::BODY)));
+                response.headers_mut().insert(
+                    hyper::header::CONTENT_TYPE,
+                    hyper::header::HeaderValue::from_static("text/plain"),
+                );
+                Ok::<_, Infallible>(response)
+            }),
+        );
+        tokio::spawn(async move { connection_finished(connection.await) });
+    }
+}
+
+/// Run a multi-worker mode: `base-native-mt`, `base-iouring-mt` or `hyper-tokio-mt` with `workers` application workers.
+pub fn run(backend: &str, workers: usize) -> Result<()> {
+    match backend {
+        "base-native-mt" => {
+            use base_scheduler_native::{NativeOptions, NativeScheduler};
+            let scheduler = Arc::new(NativeScheduler::with_options(NativeOptions {
+                workers,
+                threads: 1,
+                capacity: MAX_CONNECTIONS,
+                ..Default::default()
+            })?);
+            let result = scheduler.block_on(base_server(scheduler.clone()));
+            scheduler.block_on(scheduler.shutdown());
+            result
+        }
+        #[cfg(target_os = "linux")]
+        "base-iouring-mt" => {
+            use base_scheduler_iouring::{IoUringOptions, IoUringSelector};
+            use base_scheduler_native::{NativeExecutorOptions, NativeScheduler};
+            let (selector, drivers) = IoUringSelector::with_workers(
+                IoUringOptions {
+                    capacity: MAX_CONNECTIONS,
+                    fallback: base_scheduler_selector::SelectorOptions { threads: 1, capacity: MAX_CONNECTIONS },
+                    ..Default::default()
+                },
+                workers,
+            )?;
+            let scheduler = Arc::new(NativeScheduler::with_drivers(
+                selector,
+                drivers,
+                NativeExecutorOptions { workers, ..Default::default() },
+            )?);
+            let result = scheduler.block_on(base_server(scheduler.clone()));
+            scheduler.block_on(scheduler.shutdown());
+            result
+        }
+        "hyper-tokio-mt" => tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(workers)
+            .enable_all()
+            .build()?
+            .block_on(hyper_server()),
+        _ => Err(format!("unknown multi-worker backend {backend}").into()),
+    }
+}
