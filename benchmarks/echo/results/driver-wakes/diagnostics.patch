+++ b/crates/native/src/work_counters.rs
@@ -0,0 +1,93 @@
+// Temporary work-distribution diagnostics. Not for merging.
+
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub const NAMES: [&str; 16] = [
+    "polls",
+    "migrations",
+    "schedule_local",
+    "schedule_remote_worker",
+    "schedule_remote_external",
+    "wake_idle_batch",
+    "wake_idle_schedule",
+    "wake_idle_none_idle",
+    "wakes_batch",
+    "wakes_schedule",
+    "idle_entries",
+    "idle_recheck_found",
+    "parks",
+    "steal_ready",
+    "steal_incoming",
+    "batches",
+];
+
+#[repr(align(128))]
+struct Slot([AtomicU64; 16]);
+
+const SLOTS: usize = 17;
+static COUNTERS: [Slot; SLOTS] = [const { Slot([const { AtomicU64::new(0) }; 16]) }; SLOTS];
+
+thread_local! {
+    static INDEX: Cell<usize> = const { Cell::new(SLOTS - 1) };
+}
+
+pub fn enter(identifier: usize) {
+    INDEX.with(|index| index.set(identifier.min(SLOTS - 2)));
+}
+
+#[inline]
+pub fn count(counter: usize) {
+    count_shared(counter);
+}
+
+#[inline]
+pub fn count_shared(counter: usize) {
+    let index = INDEX.with(Cell::get);
+    COUNTERS[index].0[counter].fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn snapshot() -> Vec<(&'static str, u64)> {
+    NAMES
+        .iter()
+        .enumerate()
+        .map(|(i, name)| {
+            (
+                *name,
+                COUNTERS
+                    .iter()
+                    .map(|slot| slot.0[i].load(Ordering::Relaxed))
+                    .sum(),
+            )
+        })
+        .collect()
+}
+
+pub const POLLS: usize = 0;
+pub const MIGRATIONS: usize = 1;
+pub const SCHEDULE_LOCAL: usize = 2;
+pub const SCHEDULE_REMOTE_WORKER: usize = 3;
+pub const SCHEDULE_REMOTE_EXTERNAL: usize = 4;
+pub const WAKE_IDLE_BATCH: usize = 5;
+pub const WAKE_IDLE_SCHEDULE: usize = 6;
+pub const WAKE_IDLE_NONE_IDLE: usize = 7;
+pub const WAKES_BATCH: usize = 8;
+pub const WAKES_SCHEDULE: usize = 9;
+pub const IDLE_ENTRIES: usize = 10;
+pub const IDLE_RECHECK_FOUND: usize = 11;
+pub const PARKS: usize = 12;
+pub const STEAL_READY: usize = 13;
+pub const STEAL_INCOMING: usize = 14;
+pub const BATCHES: usize = 15;
+
+pub static POLICY: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(usize::MAX);
+#[inline]
+pub fn policy() -> usize {
+    let value = POLICY.load(Ordering::Relaxed);
+    if value != usize::MAX {
+        return value;
+    }
+    let value = std::env::var("BASE_WD_POLICY").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+    POLICY.store(value, Ordering::Relaxed);
+    value
+}
