+pub(crate) fn route_index(group: &Arc<DriverGroup>) -> Option<usize> {
+    ROUTES.with(|routes| {
+        routes
+            .borrow()
+            .iter()
+            .rev()
+            .find(|route| Arc::ptr_eq(&route.group, group))
+            .map(|route| route.controller.worker)
+    })
+}
