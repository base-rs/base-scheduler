+#[test]
+fn earlier_external_timer_interrupts_an_existing_io_wait_without_a_timer_thread() {
+    use core_scheduler::{Cancellation, Clock};
+    use futures_lite::future::poll_once;
+    crate::test_support::run(|| {
+        let state = Arc::new(State::default());
+        let scheduler = construct(&[Arc::clone(&state)]);
+        crate::thread::FAIL_AFTER.set(Some(0));
+        let never = Cancellation::never();
+        let mut distant = Box::pin(scheduler.sleep(Duration::from_secs(3600), &never));
+        assert!(block_on(poll_once(&mut distant)).is_none());
+        wait(|| state.timed_waits.load(Ordering::SeqCst) > 0);
+        let before = std::time::Instant::now();
+        block_on(scheduler.sleep(Duration::from_millis(20), &never)).unwrap();
+        assert!(before.elapsed() < Duration::from_secs(2));
+        assert_eq!(crate::thread::FAIL_AFTER.take(), Some(0));
+        drop(distant);
+        let turns = state.turns.load(Ordering::SeqCst);
+        thread::sleep(Duration::from_millis(30));
+        assert!(state.turns.load(Ordering::SeqCst) - turns < 20);
+        block_on(scheduler.shutdown());
+    });
+}
+
+#[test]
+fn worker_timer_delivery_is_drained_during_shutdown() {
+    use core_scheduler::{Cancellation, Clock};
+    use futures_lite::future::poll_once;
+    use std::task::Context;
+    crate::test_support::run(|| {
+        struct GatedWake(Arc<crate::test_support::Gate>);
+        impl Wake for GatedWake {
+            fn wake(self: Arc<Self>) {
+                self.0.wait();
+            }
+        }
+        let scheduler = construct(&[Arc::new(State::default())]);
+        let (gate, started, release) = crate::test_support::Gate::new();
+        let waker = Waker::from(Arc::new(GatedWake(gate)));
+        let never = Cancellation::never();
+        let mut sleep = Box::pin(scheduler.sleep(Duration::from_millis(20), &never));
+        assert!(
+            sleep
+                .as_mut()
+                .poll(&mut Context::from_waker(&waker))
+                .is_pending()
+        );
+        started.recv_timeout(Duration::from_secs(5)).unwrap();
+        let mut shutdown = Box::pin(scheduler.shutdown());
+        assert!(block_on(poll_once(&mut shutdown)).is_none());
+        drop(release);
+        block_on(shutdown);
+        block_on(sleep).unwrap();
+    });
+}
