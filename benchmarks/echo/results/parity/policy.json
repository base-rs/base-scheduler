  "patch": "diff --git a/crates/iouring/src/io_uring_selector.rs b/crates/iouring/src/io_uring_selector.rs\nindex d6043f5..5464f67 100644\n--- a/crates/iouring/src/io_uring_selector.rs\n+++ b/crates/iouring/src/io_uring_selector.rs\n@@ -546,7 +546,13 @@ impl IoUringSelector {\n         group: Arc<DriverGroup>,\n         worker: usize,\n     ) -> io::Result<IoUringDriver> {\n-        let ring = syscall(\"ring\", || IoUring::new(options.entries))?;\n+        let ring = syscall(\"ring\", || {\n+            let mut builder = IoUring::builder();\n+            if std::env::var(\"CORE_SCHEDULER_TASKWORK\").as_deref() == Ok(\"cooperative\") {\n+                builder.setup_coop_taskrun().setup_taskrun_flag();\n+            }\n+            builder.build(options.entries)\n+        })?;\n         syscall(\"completion-support\", || {\n             validate_completion_support(\n                 ring.params().is_feature_nodrop(),\n@@ -1289,7 +1295,9 @@ impl Reactor {\n         if return_to_executor {\n             let needs_submit = {\n                 let submissions = self.ring.submission();\n-                (!submissions.is_empty() && !defer_submission) || submissions.cq_overflow()\n+                (!submissions.is_empty() && !defer_submission)\n+                    || submissions.cq_overflow()\n+                    || submissions.taskrun()\n             };\n             if needs_submit {\n                 let before = self\n",
