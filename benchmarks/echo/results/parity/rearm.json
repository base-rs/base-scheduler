  "patch": "diff --git a/crates/iouring/src/io_uring_selector.rs b/crates/iouring/src/io_uring_selector.rs\nindex d6043f5..b52ced8 100644\n--- a/crates/iouring/src/io_uring_selector.rs\n+++ b/crates/iouring/src/io_uring_selector.rs\n@@ -466,6 +466,7 @@ pub(crate) struct DriverGroup {\n     controllers: OnceLock<Vec<Weak<Controller>>>,\n     fallback: Arc<ReadinessSelector>,\n     closed: AtomicBool,\n+    stream_rearm: bool,\n }\n impl DriverGroup {\n     pub(crate) fn close(&self) {\n@@ -519,6 +520,7 @@ impl IoUringSelector {\n             controllers: OnceLock::new(),\n             fallback: Arc::clone(&fallback),\n             closed: AtomicBool::new(false),\n+            stream_rearm: std::env::var_os(\"CORE_SCHEDULER_STREAM_REARM\").is_some(),\n         });\n         let mut controllers = Vec::with_capacity(workers);\n         let mut drivers = Vec::with_capacity(workers);\n@@ -546,7 +548,13 @@ impl IoUringSelector {\n         group: Arc<DriverGroup>,\n         worker: usize,\n     ) -> io::Result<IoUringDriver> {\n-        let ring = syscall(\"ring\", || IoUring::new(options.entries))?;\n+        let ring = syscall(\"ring\", || {\n+            let mut builder = IoUring::builder();\n+            if std::env::var(\"CORE_SCHEDULER_TASKWORK\").as_deref() == Ok(\"cooperative\") {\n+                builder.setup_coop_taskrun().setup_taskrun_flag();\n+            }\n+            builder.build(options.entries)\n+        })?;\n         syscall(\"completion-support\", || {\n             validate_completion_support(\n                 ring.params().is_feature_nodrop(),\n@@ -1289,7 +1297,9 @@ impl Reactor {\n         if return_to_executor {\n             let needs_submit = {\n                 let submissions = self.ring.submission();\n-                (!submissions.is_empty() && !defer_submission) || submissions.cq_overflow()\n+                (!submissions.is_empty() && !defer_submission)\n+                    || submissions.cq_overflow()\n+                    || submissions.taskrun()\n             };\n             if needs_submit {\n                 let before = self\ndiff --git a/crates/iouring/src/io_uring_selector/monitor.rs b/crates/iouring/src/io_uring_selector/monitor.rs\nindex 9bfeb09..d23698d 100644\n--- a/crates/iouring/src/io_uring_selector/monitor.rs\n+++ b/crates/iouring/src/io_uring_selector/monitor.rs\n@@ -21,6 +21,8 @@ pub struct IoUringMonitorRegistration {\n     claimed: AtomicBool,\n     readiness: AtomicU64,\n     multishot: AtomicBool,\n+    stream_rearm: bool,\n+    poll_first: AtomicBool,\n     status: Arc<Mutex<Status>>,\n }\n #[derive(Default)]\n@@ -275,6 +277,7 @@ impl IoUringSelector {\n         monitor: &MonitorStorage<M>,\n         interest: Interest,\n         cancellation: &Cancellation,\n+        poll_first: bool,\n         mut operation: impl FnMut(&NativeSocket) -> io::Result<T> + Send,\n     ) -> OperationResult<T> {\n         let state = monitor.as_ref();\n@@ -286,6 +289,19 @@ impl IoUringSelector {\n                 cancellation.check()?;\n                 self.check_monitor(state)?;\n                 state.check_interest(interest)?;\n+                if poll_first\n+                    && registration.poll_first.load(Ordering::Acquire)\n+                    && registration.readiness.load(Ordering::Acquire) & READY == 0\n+                {\n+                    if wait.is_none() {\n+                        wait = Some((Wait::claim(state)?, self.route()));\n+                    }\n+                    if cancelled.as_mut().poll(context).is_ready() {\n+                        return Poll::Ready(Err(core_scheduler::Cancelled.into()));\n+                    }\n+                    let (_, controller) = wait.as_ref().unwrap();\n+                    std::task::ready!(self.poll_monitor_wait(monitor, controller, context))?;\n+                }\n                 let readiness = registration.readiness.load(Ordering::Acquire);\n                 match operation(state.socket()) {\n                     Err(error) if error.kind() == io::ErrorKind::WouldBlock => {\n@@ -328,11 +344,33 @@ impl SocketMonitoring for IoUringSelector {\n                 closed: AtomicBool::new(false),\n                 readiness: AtomicU64::new(0),\n                 multishot: AtomicBool::new(true),\n+                stream_rearm: false,\n+                poll_first: AtomicBool::new(false),\n                 claimed: AtomicBool::new(false),\n                 status: Arc::new(Mutex::new(Status::default())),\n             },\n         ))\n     }\n+    fn socket_stream_monitor_state(\n+        &self,\n+        socket: &NativeSocket,\n+        interest: Interest,\n+    ) -> io::Result<SocketStreamMonitor<NativeSocket, IoUringMonitorRegistration>> {\n+        let monitor = self.socket_monitor_state(socket, interest)?;\n+        let (socket, mut registration) = monitor.into_parts();\n+        if self.group.stream_rearm\n+            && interest == Interest::Readable\n+            && super::socket::retain_socket(&socket).get_ref().r#type()? == socket2::Type::STREAM\n+        {\n+            registration.stream_rearm = true;\n+            registration.multishot.store(false, Ordering::Relaxed);\n+        }\n+        Ok(SocketStreamMonitor::new(SocketMonitor::new(\n+            socket,\n+            interest,\n+            registration,\n+        )))\n+    }\n     async fn socket_monitor_wait<\n         M: SocketMonitorState<NativeSocket, IoUringMonitorRegistration>,\n     >(\n@@ -359,8 +397,26 @@ impl SocketMonitoring for IoUringSelector {\n         flags: SocketRecvFlags,\n         cancellation: &Cancellation,\n     ) -> OperationResult<usize> {\n-        self.monitor_io(monitor, Interest::Readable, cancellation, |socket| {\n-            syscall(\"monitor-recv\", || socket.try_recv(buffer, flags))\n+        let registration = monitor.as_ref().registration();\n+        let rearm = M::STREAM && registration.stream_rearm && !buffer.is_empty() && !flags.peek;\n+        self.monitor_io(monitor, Interest::Readable, cancellation, rearm, |socket| {\n+            let observed = if rearm {\n+                registration.readiness.load(Ordering::Acquire)\n+            } else {\n+                0\n+            };\n+            let result = syscall(\"monitor-recv\", || socket.try_recv(buffer, flags));\n+            if rearm {\n+                if let Ok(count) = result {\n+                    let short = count != 0 && count < buffer.len();\n+                    registration.poll_first.store(short, Ordering::Release);\n+                    if short {\n+                        // A fresh one-shot arm checks current level readiness, including bytes after a TCP urgent-data boundary.\n+                        registration.clear_readiness(observed);\n+                    }\n+                }\n+            }\n+            result\n         })\n         .await\n     }\n@@ -373,7 +429,7 @@ impl SocketMonitoring for IoUringSelector {\n         flags: SocketSendFlags,\n         cancellation: &Cancellation,\n     ) -> OperationResult<usize> {\n-        self.monitor_io(monitor, Interest::Writable, cancellation, |socket| {\n+        self.monitor_io(monitor, Interest::Writable, cancellation, false, |socket| {\n             socket.try_send(buffer, flags)\n         })\n         .await\n@@ -387,7 +443,7 @@ impl SocketMonitoring for IoUringSelector {\n         flags: SocketRecvFlags,\n         cancellation: &Cancellation,\n     ) -> OperationResult<SocketRecvResult> {\n-        self.monitor_io(monitor, Interest::Readable, cancellation, |socket| {\n+        self.monitor_io(monitor, Interest::Readable, cancellation, false, |socket| {\n             socket.try_recvmsg(buffers, flags)\n         })\n         .await\n@@ -402,7 +458,7 @@ impl SocketMonitoring for IoUringSelector {\n         flags: SocketSendFlags,\n         cancellation: &Cancellation,\n     ) -> OperationResult<usize> {\n-        self.monitor_io(monitor, Interest::Writable, cancellation, |socket| {\n+        self.monitor_io(monitor, Interest::Writable, cancellation, false, |socket| {\n             socket.try_sendmsg(buffers, address, flags)\n         })\n         .await\ndiff --git a/crates/iouring/src/io_uring_selector/monitor/tests.rs b/crates/iouring/src/io_uring_selector/monitor/tests.rs\nindex 3177928..0b1abf1 100644\n--- a/crates/iouring/src/io_uring_selector/monitor/tests.rs\n+++ b/crates/iouring/src/io_uring_selector/monitor/tests.rs\n@@ -928,16 +928,17 @@ fn interrupted_syscalls_retry_and_observe_cancellation_and_closure() {\n         .unwrap();\n     let never = Cancellation::never();\n     let mut attempts = 0;\n-    let mut operation = Box::pin(\n-        selector.monitor_io(&writer, Interest::Writable, &never, |_| {\n-            attempts += 1;\n-            match attempts {\n-                1 => Err(io::ErrorKind::Interrupted.into()),\n-                2 => Err(io::ErrorKind::WouldBlock.into()),\n-                _ => Ok(7),\n-            }\n-        }),\n-    );\n+    let mut operation =\n+        Box::pin(\n+            selector.monitor_io(&writer, Interest::Writable, &never, false, |_| {\n+                attempts += 1;\n+                match attempts {\n+                    1 => Err(io::ErrorKind::Interrupted.into()),\n+                    2 => Err(io::ErrorKind::WouldBlock.into()),\n+                    _ => Ok(7),\n+                }\n+            }),\n+        );\n     assert_eq!(\n         drive(&mut worker, &mut context, operation.as_mut()).unwrap(),\n         7\n@@ -945,12 +946,16 @@ fn interrupted_syscalls_retry_and_observe_cancellation_and_closure() {\n     drop(operation);\n     let cancellation = Cancellation::new();\n     assert!(matches!(\n-        block_on(\n-            selector.monitor_io::<(), _>(&writer, Interest::Writable, &cancellation, |_| {\n+        block_on(selector.monitor_io::<(), _>(\n+            &writer,\n+            Interest::Writable,\n+            &cancellation,\n+            false,\n+            |_| {\n                 cancellation.cancel();\n                 Err(io::ErrorKind::Interrupted.into())\n-            })\n-        ),\n+            }\n+        )),\n         Err(OperationError::Cancelled(_))\n     ));\n     for kind in [io::ErrorKind::Interrupted, io::ErrorKind::WouldBlock] {\n@@ -960,12 +965,16 @@ fn interrupted_syscalls_retry_and_observe_cancellation_and_closure() {\n             .socket_monitor(&socket, Interest::Writable)\n             .unwrap();\n         assert_eq!(\n-            block_on(\n-                selector.monitor_io::<(), _>(&writer, Interest::Writable, &never, |_| {\n+            block_on(selector.monitor_io::<(), _>(\n+                &writer,\n+                Interest::Writable,\n+                &never,\n+                false,\n+                |_| {\n                     selector.close();\n                     Err(kind.into())\n-                })\n-            )\n+                }\n+            ))\n             .unwrap_err()\n             .kind(),\n             io::ErrorKind::BrokenPipe\n@@ -1015,8 +1024,12 @@ fn cached_readiness_survives_success_and_newer_notifications_survive_would_block\n     let before = inspect.registration().readiness.load(Ordering::Acquire);\n     let mut attempts = 0;\n     assert_eq!(\n-        block_on(\n-            selector.monitor_io(&writer, Interest::Writable, &Cancellation::never(), |_| {\n+        block_on(selector.monitor_io(\n+            &writer,\n+            Interest::Writable,\n+            &Cancellation::never(),\n+            false,\n+            |_| {\n                 attempts += 1;\n                 if attempts == 1 {\n                     // A notification racing the syscall's EAGAIN must not be cleared using the older readiness tick.\n@@ -1025,8 +1038,8 @@ fn cached_readiness_survives_success_and_newer_notifications_survive_would_block\n                 } else {\n                     Ok(5)\n                 }\n-            })\n-        )\n+            }\n+        ))\n         .unwrap(),\n         5\n     );\n",
