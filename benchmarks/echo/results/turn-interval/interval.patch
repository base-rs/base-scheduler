+#[test]
+fn nonblocking_turns_follow_the_driver_interval() {
+    crate::test_support::run(|| {
+        let state = Arc::new(State::default());
+        state.interval.store(4, Ordering::SeqCst);
+        let scheduler = construct(&[Arc::clone(&state)]);
+        let observed = Arc::clone(&state);
+        let task = scheduler
+            .spawn(async move {
+                let mut turns = Vec::new();
+                poll_fn(|context| {
+                    turns.push(observed.turns.load(Ordering::SeqCst));
+                    if turns.len() == 17 {
+                        Poll::Ready(())
+                    } else {
+                        context.waker().wake_by_ref();
+                        Poll::Pending
+                    }
+                })
+                .await;
+                turns
+            })
+            .unwrap();
+        let turns = block_on(task).unwrap();
+        // Each poll is its own batch. A busy worker still turns after every
+        // fourth poll, and only then.
+        let advanced = turns.windows(2).filter(|pair| pair[1] > pair[0]).count();
+        assert_eq!(advanced, 4, "{turns:?}");
+        assert!(
+            turns.windows(5).all(|window| window[4] > window[0]),
+            "{turns:?}"
+        );
+        block_on(scheduler.shutdown());
+        wait(|| state.retired.load(Ordering::SeqCst));
+    });
+}
