+#[test]
+fn batches_reaching_the_interval_turn_after_every_batch() {
+    const TASKS: usize = 8;
+    crate::test_support::run(|| {
+        let state = Arc::new(State::default());
+        state.interval.store(4, Ordering::SeqCst);
+        let scheduler = construct(&[Arc::clone(&state)]);
+        let started = Arc::new(AtomicUsize::new(0));
+        let tasks: Vec<_> = (0..TASKS)
+            .map(|_| {
+                let observed = Arc::clone(&state);
+                let started = Arc::clone(&started);
+                scheduler
+                    .spawn(async move {
+                        started.fetch_add(1, Ordering::SeqCst);
+                        let mut turns = Vec::new();
+                        poll_fn(|context| {
+                            // Record only once every task self-wakes into the same batch.
+                            if started.load(Ordering::SeqCst) == TASKS {
+                                turns.push(observed.turns.load(Ordering::SeqCst));
+                            }
+                            if turns.len() == 8 {
+                                Poll::Ready(())
+                            } else {
+                                context.waker().wake_by_ref();
+                                Poll::Pending
+                            }
+                        })
+                        .await;
+                        turns
+                    })
+                    .unwrap()
+            })
+            .collect();
+        for task in tasks {
+            let turns = block_on(task).unwrap();
+            assert!(turns.windows(2).all(|pair| pair[1] > pair[0]), "{turns:?}");
+        }
+        block_on(scheduler.shutdown());
+        wait(|| state.retired.load(Ordering::SeqCst));
+    });
+}
