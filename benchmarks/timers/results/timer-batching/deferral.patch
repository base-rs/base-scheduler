+#[test]
+fn an_owners_expiry_pass_leaves_idle_wakes_to_its_ready_batch() {
+    use super::{CURRENT_WORKER, LocalWorker, deferring_idle_wakes, schedule};
+    use crate::task_service::Shared;
+    use std::sync::Arc;
+
+    let mut queues = (0..2)
+        .map(|_| std::array::from_fn(|_| Worker::new_fifo()))
+        .collect::<Vec<_>>();
+    let shared = Arc::new(Shared::new(&queues, 8, false));
+    let idle = &shared.workers[1];
+    idle.thread.set(std::thread::current()).unwrap();
+    idle.sleeping.store(true, Ordering::SeqCst);
+    shared.idle_workers.store(1, Ordering::SeqCst);
+    let [ready, current] = queues.remove(0);
+    CURRENT_WORKER.with(|context| {
+        context.replace(Some(LocalWorker {
+            identifier: 0,
+            scheduler: Arc::downgrade(&shared),
+            ready,
+            current,
+        }));
+    });
+
+    // The owner keeps the tasks its pass wakes, without interrupting the sleeping worker.
+    deferring_idle_wakes(|| {
+        schedule(&shared, runnable());
+        schedule(&shared, runnable());
+    });
+    assert!(idle.sleeping.load(Ordering::SeqCst));
+    // Other wakes still offer the work to an idle worker.
+    schedule(&shared, runnable());
+    assert!(!idle.sleeping.load(Ordering::SeqCst));
+    let local = CURRENT_WORKER.with(|context| context.take()).unwrap();
+    assert_eq!(local.ready.len(), 3);
+}
