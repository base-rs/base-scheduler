+
+/// Invoke an owner's expired wakers without waking an idle worker for each task they push to this worker's queue.
+///
+/// Those wakes are not needed for progress: the owner is running, and it searches its own queue before it can advertise sleep. They exist so that idle workers can share a batch, and `run_ready_batch` already wakes one when the batch it starts holds more than one task. Waking per timer instead put an interrupt of a sleeping neighbour on the path of a lone expiry, ahead of the task it was due to run, and woke up to every idle neighbour for one pass.
+pub(crate) fn deferring_idle_wakes(wake: impl FnOnce()) {
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            DEFERRING_IDLE_WAKES.with(|deferring| deferring.set(false));
+        }
+    }
+    DEFERRING_IDLE_WAKES.with(|deferring| deferring.set(true));
+    let _reset = Reset;
+    wake();
 }
 
