 mod native_timer;
 pub use native_timer::NativeTimer;
+
+// Experiment: timers fired per expiry pass, in log2 buckets (bucket b counts passes firing [2^(b-1), 2^b) timers).
+static TIMER_BATCHES: [std::sync::atomic::AtomicU64; 16] = [const { std::sync::atomic::AtomicU64::new(0) }; 16];
+pub(crate) fn record_batch(fired: usize) {
+    if fired > 0 {
+        let bucket = (usize::BITS - fired.leading_zeros()) as usize;
+        TIMER_BATCHES[bucket.min(15)].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+/// Experiment: the histogram of timers fired per expiry pass.
+pub fn timer_batch_histogram() -> Vec<u64> {
+    TIMER_BATCHES.iter().map(|count| count.load(std::sync::atomic::Ordering::Relaxed)).collect()
+}
