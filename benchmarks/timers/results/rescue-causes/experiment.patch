+// Experiment: how long a task woken from another thread takes to run on an idle Native worker with no timers pending.
+// Usage: wake_latency BACKEND WORKERS WAKES
+use base_scheduler::Spawn;
+use std::{
+    future::Future,
+    pin::Pin,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+        mpsc,
+    },
+    task::{Context, Poll, Waker},
+    time::{Duration, Instant},
+};
+
+#[derive(Default)]
+struct Slot {
+    waker: Mutex<Option<Waker>>,
+    fired: AtomicBool,
+}
+
+struct Wait<'a>(&'a Slot);
+impl Future for Wait<'_> {
+    type Output = ();
+    fn poll(self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<()> {
+        let mut waker = self.0.waker.lock().unwrap();
+        if self.0.fired.swap(false, Ordering::AcqRel) {
+            return Poll::Ready(());
+        }
+        *waker = Some(context.waker().clone());
+        Poll::Pending
+    }
+}
+
+fn run<S: Spawn>(scheduler: &S, wakes: usize) -> serde_json::Value {
+    let slot = Arc::new(Slot::default());
+    let (resumed, receive) = mpsc::channel::<Instant>();
+    let task_slot = Arc::clone(&slot);
+    let task = scheduler
+        .spawn(async move {
+            for _ in 0..wakes {
+                Wait(&task_slot).await;
+                let _ = resumed.send(Instant::now());
+            }
+        })
+        .unwrap();
+    let mut latencies = Vec::with_capacity(wakes);
+    let mut lost = 0;
+    let mut seed = 0x9e3779b97f4a7c15u64;
+    for _ in 0..wakes {
+        // Wait until the task has parked its waker, then long enough for its worker to go idle.
+        while slot.waker.lock().unwrap().is_none() {
+            std::thread::yield_now();
+        }
+        seed ^= seed << 13;
+        seed ^= seed >> 7;
+        seed ^= seed << 17;
+        std::thread::sleep(Duration::from_micros(50 + seed % 450));
+        let waker = slot.waker.lock().unwrap().take().unwrap();
+        slot.fired.store(true, Ordering::Release);
+        let woken = Instant::now();
+        waker.wake();
+        match receive.recv_timeout(Duration::from_secs(2)) {
+            Ok(at) => latencies.push(at.saturating_duration_since(woken).as_nanos() as u64),
+            Err(_) => {
+                lost += 1;
+                // Let the run continue once the task does resume.
+                let at = receive.recv().unwrap();
+                latencies.push(at.saturating_duration_since(woken).as_nanos() as u64);
+            }
+        }
+    }
+    futures_lite::future::block_on(task).unwrap();
+    latencies.sort_unstable();
+    let q = |p: f64| latencies[((latencies.len() - 1) as f64 * p) as usize];
+    serde_json::json!({
+        "wakes": wakes,
+        "lost_over_2s": lost,
+        "over_1ms": latencies.iter().filter(|&&l| l > 1_000_000).count(),
+        "over_10ms": latencies.iter().filter(|&&l| l > 10_000_000).count(),
+        "p50_us": q(0.5) as f64 / 1e3,
+        "p99_us": q(0.99) as f64 / 1e3,
+        "p999_us": q(0.999) as f64 / 1e3,
+        "max_us": q(1.0) as f64 / 1e3,
+    })
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let backend = args[1].as_str();
+    let workers: usize = args[2].parse().unwrap();
+    let wakes: usize = args[3].parse().unwrap();
+    let mut record = match backend {
+        "native" => {
+            let scheduler = base_scheduler_native::NativeScheduler::with_options(
+                base_scheduler_native::NativeOptions {
+                    workers,
+                    ..Default::default()
+                },
+            )
+            .unwrap();
+            let record = run(&scheduler, wakes);
+            futures_lite::future::block_on(scheduler.shutdown());
+            record
+        }
+        "iouring" => {
+            let (selector, drivers) =
+                base_scheduler_iouring::IoUringSelector::with_workers(Default::default(), workers)
+                    .unwrap();
+            let scheduler = base_scheduler_native::NativeScheduler::with_drivers(
+                selector,
+                drivers,
+                base_scheduler_native::NativeExecutorOptions {
+                    workers,
+                    ..Default::default()
+                },
+            )
+            .unwrap();
+            let record = run(&scheduler, wakes);
+            futures_lite::future::block_on(scheduler.shutdown());
+            record
+        }
+        _ => panic!("unknown backend"),
+    };
+    record["backend"] = backend.into();
+    record["workers"] = workers.into();
+    println!("{record}");
+}
