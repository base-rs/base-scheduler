+
+// Experiment: a log of stuck marks, one JSON line each, written to the file named by `BASE_NATIVE_RESCUE_LOG`.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn log(line: &str) {
+    use std::io::Write;
+    static LOG: std::sync::OnceLock<Option<std::sync::Mutex<std::fs::File>>> = std::sync::OnceLock::new();
+    let log = LOG.get_or_init(|| {
+        let path = std::env::var_os("BASE_NATIVE_RESCUE_LOG")?;
+        std::fs::OpenOptions::new().create(true).append(true).open(path).ok().map(std::sync::Mutex::new)
+    });
+    if let Some(file) = log {
+        let _ = writeln!(file.lock().unwrap(), "{line}");
+    }
+}
+
+// Experiment: a thread's CPU time in nanoseconds and its involuntary context switches, from `/proc/self/task/{tid}/sched`, which the kernel maintains without scheduler statistics.
+#[cfg(feature = "diagnostics")]
+fn sched(tid: i32) -> (u64, u64) {
+    let stat = std::fs::read_to_string(format!("/proc/self/task/{tid}/sched")).unwrap_or_default();
+    let field = |name: &str| {
+        stat.lines()
+            .find(|line| line.starts_with(name))
+            .and_then(|line| line.split(':').nth(1))
+            .map(str::trim)
+    };
+    let run = field("se.sum_exec_runtime")
+        .and_then(|value| value.parse::<f64>().ok())
+        .map_or(0, |milliseconds| (milliseconds * 1e6) as u64);
+    let involuntary = field("nr_involuntary_switches")
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(0);
+    (run, involuntary)
 }
 
